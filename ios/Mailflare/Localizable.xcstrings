    "%@ was signed out on the server. Its mail was removed from this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde auf dem Server abgemeldet. Die Mails dieses Kontos wurden von diesem Gerät entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was signed out on the server. Its mail was removed from this device."
          }
        }
