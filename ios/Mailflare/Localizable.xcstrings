    },
    "A notification shows sender, subject and the first lines. Archive, mark as read and delete work from the notification itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mitteilung zeigt Absender, Betreff und die ersten Zeilen. Archivieren, als gelesen markieren und löschen gehen direkt in der Mitteilung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A notification shows sender, subject and the first lines. Archive, mark as read and delete work from the notification itself."
          }
        }
      }
    },
