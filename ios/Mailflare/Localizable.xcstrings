    "The device is signed out at once. The mail already on it is removed the next time it reaches the server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät wird sofort abgemeldet. Die Mails, die schon darauf liegen, werden entfernt, sobald es den Server das nächste Mal erreicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device is signed out at once. The mail already on it is removed the next time it reaches the server."
          }
        }
      }
    },
