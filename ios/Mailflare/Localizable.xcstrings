      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät braucht einen eigenen Service-Token für Cloudflare Access. Lege ihn in Cloudflare Zero Trust an und gib seine beiden Teile hier ein. Sie bleiben im Schlüsselbund dieses Geräts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device needs its own Cloudflare Access service token. Create one in Cloudflare Zero Trust and enter its two parts here. They are kept in the keychain of this device only."
